{
  "compilerOptions": {
    "target": "ES2022",                          /* Версия компилируемого JS */
    "module": "NodeNext",                        /* Современная система модулей */
    "moduleResolution": "NodeNext",
    "rootDir": "./src",                          /* Где лежит ваш исходный код */
    "outDir": "./dist",                          /* Куда будут складываться скомпилированные файлы */
    "strict": true,                              /* Включение строгих проверок типов */
    "esModuleInterop": true,                     /* Совместимость с CommonJS модулями */
    "skipLibCheck": true                         /* Пропускать проверку типов в библиотеках */
  },
  "include": ["src/**/*"]                        /* Указывает компилятору проверять только папку src */
}
